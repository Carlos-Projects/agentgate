# AgentGate Environment Variables

# Redis (optional, for production rate limiting)
# Get from https://upstash.com
AGENTGATE_REDIS_URL=your-redis-url
AGENTGATE_REDIS_TOKEN=your-redis-token

# Dashboard authentication (required for production)
# Generate with: openssl rand -hex 32
AGENTGATE_DASHBOARD_TOKEN=your-secure-token

# Webhooks (optional)
AGENTGATE_WEBHOOK_URL=https://your-webhook-endpoint.com/webhook
AGENTGATE_WEBHOOK_SECRET=your-signing-secret

# Node environment
NODE_ENV=development
