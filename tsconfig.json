{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "declaration": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/core/**/*", "src/store/**/*", "src/rate-limit/**/*", "src/session/**/*", "src/webhooks/**/*", "src/logger/**/*", "src/dashboard/**/*", "src/honeypot/**/*", "src/index.ts"],
  "exclude": ["node_modules", "dist", "examples", "tests", "src/adapters", "src/bin"]
}
